/* 全局基础样式：与站点一致的浅色卡片风。 */
page {
  background: #f5f6f8;
  color: #1f2328;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  margin: 12rpx 12rpx 0 0;
  background: #f3f4f6;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4b5563;
}

.chip.category {
  background: #eef2ff;
  color: #4f46e5;
}

.state {
  text-align: center;
  color: #9ca3af;
  padding: 40rpx 0;
  font-size: 26rpx;
}
