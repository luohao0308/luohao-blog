.page {
  padding: 24rpx 24rpx 160rpx;
}

.thread {
  display: flex;
  flex-direction: column;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.bubble {
  max-width: 82%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

.bubble-user {
  background: #2563eb;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.msg-bot .bubble {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  color: #1f2328;
  border-top-left-radius: 6rpx;
}

.bubble-error {
  background: #fef2f2 !important;
  border-color: #fecaca !important;
  color: #b91c1c !important;
}

.citations {
  max-width: 82%;
  margin-top: 12rpx;
}

.citations-title {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.citation {
  display: block;
  background: #eff6ff;
  color: #1d4ed8;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.typing {
  color: #94a3b8;
  font-size: 24rpx;
  padding-left: 8rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
}

.composer-input {
  flex: 1;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.composer-placeholder {
  color: #94a3b8;
}

.composer-send {
  margin-left: 16rpx;
  background: #2563eb;
  color: #fff;
  font-size: 26rpx;
}

.composer-send[disabled] {
  background: #93c5fd;
  color: #fff;
}
