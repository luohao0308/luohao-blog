<view class="page">
  <view wx:if="{{mode === 'loading'}}" class="state">加载中…</view>

  <!-- 已登录 -->
  <view wx:elif="{{mode === 'signedin'}}" class="me-card">
    <view class="me-avatar">{{account.avatarUrl ? '' : '👤'}}</view>
    <view class="me-name">{{account.displayName}}</view>
    <view class="me-tip">{{account.email}}</view>
    <button class="me-action" size="mini" bindtap="signOut">退出登录</button>
  </view>

  <!-- 绑定已有账号 -->
  <view wx:elif="{{mode === 'binding'}}" class="me-card">
    <view class="me-name">绑定已有账号</view>
    <view class="me-tip">微信号首次使用，输入你在网页版注册的邮箱和密码完成绑定</view>
    <input class="me-input" placeholder="邮箱" value="{{email}}" bindinput="onEmailInput" />
    <input class="me-input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
    <view wx:if="{{error}}" class="me-error">{{error}}</view>
    <button class="me-action primary" size="mini" loading="{{busy}}" bindtap="submitBind">绑定并登录</button>
    <button class="me-action" size="mini" bindtap="cancelBind">取消</button>
  </view>

  <!-- 未登录 -->
  <view wx:else class="me-card">
    <view class="me-avatar">👤</view>
    <view class="me-name">未登录</view>
    <view class="me-tip">使用微信快捷登录，绑定你的博客账号后可评论、收藏</view>
    <view wx:if="{{error}}" class="me-error">{{error}}</view>
    <button class="me-action primary" size="mini" loading="{{busy}}" bindtap="startWechatLogin">微信登录</button>
  </view>
</view>
