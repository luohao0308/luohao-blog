.me-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.me-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 56rpx;
  line-height: 128rpx;
  margin: 0 auto;
}

.me-name {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.me-tip {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.me-input {
  margin-top: 20rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  text-align: left;
}

.me-error {
  margin-top: 20rpx;
  color: #dc2626;
  font-size: 24rpx;
}

.me-action {
  margin-top: 24rpx;
}

.me-action.primary {
  background: #4f46e5;
  color: #fff;
}
