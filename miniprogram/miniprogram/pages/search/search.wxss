.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  background: #2563eb;
  color: #fff;
  font-size: 26rpx;
}

.search-btn[disabled] {
  background: #93c5fd;
  color: #fff;
}

.hint {
  color: #94a3b8;
}

.result-card {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
}

.result-summary {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.result-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
}

.result-tag {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
}

.state {
  text-align: center;
  color: #9ca3af;
  padding: 40rpx 0;
  font-size: 26rpx;
}
