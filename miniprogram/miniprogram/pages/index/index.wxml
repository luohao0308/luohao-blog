<view class="page">
  <!-- 搜索入口 -->
  <view class="search-bar" bindtap="openSearch">
    <text class="search-icon">⌕</text>
    <text class="search-hint">搜索文章（关键词 + 语义）</text>
  </view>

  <!-- 分类筛选（后台建了分类才出现） -->
  <scroll-view wx:if="{{categories.length}}" scroll-x class="chip-row">
    <view class="chip-cell">
      <text class="pill {{activeCategory === '' ? 'pill-active' : ''}}" bindtap="setCategory" data-slug="">全部</text>
    </view>
    <view class="chip-cell" wx:for="{{categories}}" wx:key="slug">
      <text class="pill {{activeCategory === item.slug ? 'pill-active' : ''}}" bindtap="setCategory" data-slug="{{item.slug}}">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 标签筛选（从已加载文章收集） -->
  <scroll-view wx:if="{{tags.length}}" scroll-x class="chip-row">
    <view class="chip-cell">
      <text class="pill {{activeTag === '' && !activeCategory ? 'pill-active' : ''}}" bindtap="setTag" data-tag="">全部</text>
    </view>
    <view class="chip-cell" wx:for="{{tags}}" wx:key="*this">
      <text class="pill {{activeTag === item ? 'pill-active' : ''}}" bindtap="setTag" data-tag="{{item}}">{{item}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中…</view>

  <view wx:elif="{{error}}" class="state">
    <view>{{error}}</view>
    <button class="retry-btn" size="mini" bindtap="loadFirst">重试</button>
  </view>

  <block wx:else>
    <view
      wx:for="{{articles}}"
      wx:key="slug"
      class="card"
      bindtap="openPost"
      data-slug="{{item.slug}}"
    >
      <view class="card-title">{{item.title}}</view>
      <view wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</view>
      <view class="card-meta">
        <text class="meta-item">{{item.dateText}}</text>
        <text wx:if="{{item.categoryName}}" class="meta-item">{{item.categoryName}}</text>
        <text class="meta-item">阅读 {{item.viewCount}}</text>
      </view>
      <view wx:if="{{item.tags.length}}" class="card-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="chip">{{tag}}</text>
      </view>
    </view>

    <view class="state">
      {{finished ? (articles.length ? '— 到底啦 —' : '还没有文章') : (loadingMore ? '加载中…' : '上拉加载更多')}}
    </view>
  </block>

  <!-- AI 问答浮窗 -->
  <view class="chat-fab" bindtap="openChat">
    <text class="chat-fab-icon">AI</text>
    <text class="chat-fab-text">问一问</text>
  </view>
</view>
