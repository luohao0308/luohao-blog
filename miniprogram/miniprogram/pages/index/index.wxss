.card-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.card-summary {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.meta-item {
  margin-right: 20rpx;
}

.retry-btn {
  margin-top: 24rpx;
}
