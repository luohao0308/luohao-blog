# 根级忽略：环境变量与系统文件；各子项目另有细分 .gitignore
.DS_Store
.env
.env.*
!.env.example
*.log
node_modules/

# 本机密钥：真实 API key 只进这个文件，禁止提交
backend/configs/secrets.local.yaml

# 生产环境：真实域名/密码/密钥只进这两个文件
deploy/.env.prod
deploy/prod-conf/secrets.local.yaml

# 数据库备份含全库数据，只留本机；模板放行见下方白名单
backups/

# 本机 Python 产物（scripts/ 下的工具链）
__pycache__/
*.pyc

# .env.* 默认全部忽略，这里放行需要随仓库分发的 example 模板
!deploy/.env.prod.example
