# 监控栈环境变量模板：复制为 deploy/.env.monitoring 并填入真实值（Git 忽略）。
#   cp deploy/.env.monitoring.example deploy/.env.monitoring
# 服务器上权限收紧：chmod 600 deploy/.env.monitoring

# Grafana 管理员（只绑 127.0.0.1，经 SSH 隧道访问）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-openssl-rand-hex-12

# Kuma 管理员（首次浏览器初始化时创建，回写记录在此）
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=changeme

# mysqld-exporter 连接账号（服务器上自动创建的最小权限用户，见 runbook §4）
MYSQLD_EXPORTER_PASSWORD=changeme

# redis-exporter 复用生产 Redis 密码（与 deploy/.env.prod 同值）
REDIS_PASSWORD=changeme
