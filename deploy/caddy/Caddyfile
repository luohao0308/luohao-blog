# 生产反代（M5/S1）：Caddy 自动签发 HTTPS。
# SITE_ADDRESS 由 deploy/.env.prod 注入：生产设为域名（如 blog.example.com），
# 本地冒烟默认 :80 纯 HTTP。
#
# 全部流量都反代到 Nuxt（BFF）：它同时服务页面和 /api/** 代理，并负责把
# refresh cookie 的 Path 从 /v1/auth 重写为 /api/v1/auth——若把 /api/* 直接
# 反代到 Kratos 会绕过该重写，刷新闭环会静默失效（M2/S4 坑五）。

{$SITE_ADDRESS::80} {
	encode gzip
	log {
		output stdout
		format console
	}
	# 请求体外层兜底：Kratos 解码器会在限流/校验之前把整个 body 读进内存，
	# 这里在公网入口统一封顶（后端另有 1MiB 默认/头像路由 4MiB 的精确上限，
	# 8MB 为头像 base64 ~2.7MB 留出余量）。
	request_body {
		max_size 8MB
	}
	reverse_proxy frontend:3000
}
