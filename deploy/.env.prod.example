# 生产环境变量模板：复制为 deploy/.env.prod（Git 忽略）后填入真实值。
# compose 经 --env-file deploy/.env.prod 读取；后端密钥另见
# deploy/prod-conf/secrets.local.yaml（模板同目录 example）。

# 生产域名入口（DNS @/www 先完成解析，80/443 可达）。
# 本地 HTTP 冒烟：SITE_ADDRESS=:80、CADDY_CONFIG=Caddyfile、AUTH_SECURE_COOKIE=false。
SITE_ADDRESS=makerhao.cn
CADDY_CONFIG=Caddyfile.domain
PUBLIC_SITE_URL=https://makerhao.cn
ICP_NUMBER=渝ICP备2026025040号-1
AUTH_SECURE_COOKIE=true

# 镜像版本：建议生产发布固定为 GitHub Actions 产出的提交 SHA；留空或删除时使用 latest。
IMAGE_TAG=latest

# MySQL：compose 服务与后端 DSN 同源，务必强密码。
MYSQL_ROOT_PASSWORD=changeme
# 与 MYSQL_ROOT_PASSWORD 保持一致。
DATABASE_SOURCE=root:changeme@tcp(mysql:3306)/blog?timeout=5s&multiStatements=true&parseTime=True&loc=Local&charset=utf8mb4

# Redis AUTH 密码（openssl rand -hex 32）。同源注入 Redis requirepass 与
# 后端 KRATOS_REDIS_PASSWORD；缺失时 compose 拒绝启动 redis 服务。
REDIS_PASSWORD=changeme

# JWT 签名密钥（openssl rand -hex 32）。空值时服务拒绝启动——
# 也可改放 deploy/prod-conf/secrets.local.yaml 的 auth.jwt.secret（二选一）。
JWT_SECRET=
